# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=make_my_marriage

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend
# Local development only: set preview to use /dev/mailbox without sending emails.
EMAIL_DELIVERY_MODE=
# When using onboarding@resend.dev, invitations are limited to your Resend login email.
EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare R2 (server-only credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
